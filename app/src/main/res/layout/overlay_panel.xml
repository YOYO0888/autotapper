<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel_bg"
    android:padding="8dp"
    android:minWidth="220dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dragHandle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AutoTapper"
            android:textColor="@color/text_light"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/btnToggleSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/text_light"
            android:textSize="12sp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X"
            android:textColor="@color/text_light"
            android:padding="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set scroll points and tap point to begin."
        android:textColor="@color/text_light"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btnSetScroll"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:minHeight="0dp"
        android:textSize="12sp"
        android:text="Set Scroll Points" />

    <Button
        android:id="@+id/btnSetTap"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:minHeight="0dp"
        android:textSize="12sp"
        android:layout_marginTop="3dp"
        android:text="Set Tap Point" />

    <Button
        android:id="@+id/btnConfirmPositions"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:minHeight="0dp"
        android:textSize="12sp"
        android:layout_marginTop="3dp"
        android:text="Confirm Position"
        android:backgroundTint="@color/accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tuningContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Loop interval"
                android:textColor="@color/text_light"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnIntervalMinus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="-" />

            <TextView
                android:id="@+id/tvIntervalValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1500"
                android:textColor="@color/text_light"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnIntervalPlus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Slide speed"
                android:textColor="@color/text_light"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSlideMinus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="-" />

            <TextView
                android:id="@+id/tvSlideValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="300"
                android:textColor="@color/text_light"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSlidePlus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Click delay"
                android:textColor="@color/text_light"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnClickDelayMinus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="-" />

            <TextView
                android:id="@+id/tvClickDelayValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="300"
                android:textColor="@color/text_light"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnClickDelayPlus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tap radius"
                android:textColor="@color/text_light"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRadiusMinus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="-" />

            <TextView
                android:id="@+id/tvRadiusValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_light"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRadiusPlus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tap count"
                android:textColor="@color/text_light"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTapCountMinus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="-" />

            <TextView
                android:id="@+id/tvTapCountValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_light"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTapCountPlus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tap gap"
                android:textColor="@color/text_light"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTapGapMinus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="-" />

            <TextView
                android:id="@+id/tvTapGapValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="150"
                android:textColor="@color/text_light"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTapGapPlus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scroll jitter"
                android:textColor="@color/text_light"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/editScrollJitter"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:layout_marginStart="8dp"
                android:inputType="number"
                android:text="0"
                android:textColor="@color/text_light"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:textSize="12sp"
            android:text="Start"
            android:backgroundTint="@color/accent" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:layout_weight="1"
            android:textSize="12sp"
            android:layout_marginStart="3dp"
            android:text="Stop"
            android:backgroundTint="@color/danger"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>
