<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel_bg"
    android:padding="12dp"
    android:minWidth="240dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dragHandle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⠿ AutoTapper"
            android:textColor="@color/text_light"
            android:textStyle="bold"
            android:padding="6dp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="@color/text_light"
            android:padding="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set scroll points and tap point to begin."
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSetScroll"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Scroll Points" />

    <Button
        android:id="@+id/btnSetTap"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Set Tap Point" />

    <Button
        android:id="@+id/btnConfirmPositions"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Confirm Position"
        android:backgroundTint="@color/accent"
        android:visibility="gone" />

    <!-- Loop interval: pause between full scroll+tap cycles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Loop interval (ms):"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnIntervalMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvIntervalValue"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1500"
            android:textColor="@color/text_light"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnIntervalPlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>

    <!-- Slide speed: how long the swipe gesture itself takes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Slide speed (ms):"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSlideMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvSlideValue"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="300"
            android:textColor="@color/text_light"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSlidePlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>

    <!-- Click delay: pause after the swipe finishes, before the tap fires -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Click delay (ms):"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnClickDelayMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvClickDelayValue"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="300"
            android:textColor="@color/text_light"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClickDelayPlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wait after swipe, before tapping"
        android:textColor="@color/text_light"
        android:textSize="10sp"
        android:alpha="0.7" />

    <!-- Tap radius: randomization zone around the tap point -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap radius (px):"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRadiusMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvRadiusValue"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/text_light"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRadiusPlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 = always tap the exact same spot"
        android:textColor="@color/text_light"
        android:textSize="10sp"
        android:alpha="0.7" />

    <!-- Tap count: how many times to tap per cycle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap count:"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTapCountMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvTapCountValue"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_light"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTapCountPlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Taps in a row per cycle, e.g. tick-tick-tick"
        android:textColor="@color/text_light"
        android:textSize="10sp"
        android:alpha="0.7" />

    <!-- Scroll jitter: keeps a manual number field since it's used less often -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scroll jitter (px):"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editScrollJitter"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:inputType="number"
            android:text="0"
            android:textColor="@color/text_light"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 = swipe the exact same line every time"
        android:textColor="@color/text_light"
        android:textSize="10sp"
        android:alpha="0.7" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start"
            android:backgroundTint="@color/accent" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Stop"
            android:backgroundTint="@color/danger"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>
