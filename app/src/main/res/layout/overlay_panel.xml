<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="10dp"
        android:minWidth="272dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dragHandle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⠿  AutoTapper  v3"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="13sp"
                android:padding="4dp" />

            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:padding="6dp" />

            <TextView
                android:id="@+id/btnToggleSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textColor="@color/text_dim"
                android:textSize="15sp"
                android:padding="6dp" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:padding="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/status_chip"
            android:padding="8dp"
            android:text="No steps yet."
            android:textColor="@color/text_light"
            android:textSize="11sp" />

        <!-- Add step / record row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnAddTap"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:background="@drawable/btn_secondary"
                android:text="+ Tap"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAddSwipe"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_secondary"
                android:text="+ Swipe"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAddWait"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_secondary"
                android:text="+ Wait"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_secondary"
            android:text="● Record"
            android:textAllCaps="false"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <!-- Picker confirm/cancel bar (shown only while placing) -->
        <LinearLayout
            android:id="@+id/pickerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnConfirmPicker"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:background="@drawable/btn_primary"
                android:text="Confirm"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCancelPicker"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_secondary"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="SEQUENCE"
            android:textColor="@color/text_dim"
            android:textSize="10sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/btnClearSteps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:padding="2dp"
            android:text="Clear all"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/stepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Settings (collapsible) -->
        <LinearLayout
            android:id="@+id/tuningContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="LOOP"
                android:textColor="@color/text_dim" android:textSize="10sp" android:letterSpacing="0.1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Loop interval (ms)"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
            <Button android:id="@+id/btnIntervalMinus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="−" />
            <TextView android:id="@+id/tvIntervalValue"
                android:layout_width="52dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="1200"
                android:textColor="@color/text_light" android:textSize="12sp" />
            <Button android:id="@+id/btnIntervalPlus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="+" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cycles (0=forever)"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
            <Button android:id="@+id/btnCyclesMinus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="−" />
            <TextView android:id="@+id/tvCyclesValue"
                android:layout_width="52dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="0"
                android:textColor="@color/text_light" android:textSize="12sp" />
            <Button android:id="@+id/btnCyclesPlus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="+" />
        </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="TAP DEFAULTS"
                android:textColor="@color/text_dim" android:textSize="10sp" android:letterSpacing="0.1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tap radius (px)"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
            <Button android:id="@+id/btnTapRadiusMinus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="−" />
            <TextView android:id="@+id/tvTapRadiusValue"
                android:layout_width="52dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="0"
                android:textColor="@color/text_light" android:textSize="12sp" />
            <Button android:id="@+id/btnTapRadiusPlus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="+" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Taps per group"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
            <Button android:id="@+id/btnTapCountMinus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="−" />
            <TextView android:id="@+id/tvTapCountValue"
                android:layout_width="52dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="1"
                android:textColor="@color/text_light" android:textSize="12sp" />
            <Button android:id="@+id/btnTapCountPlus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="+" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gap between taps (ms)"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
            <Button android:id="@+id/btnTapGapMinus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="−" />
            <TextView android:id="@+id/tvTapGapValue"
                android:layout_width="52dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="150"
                android:textColor="@color/text_light" android:textSize="12sp" />
            <Button android:id="@+id/btnTapGapPlus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="+" />
        </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="SWIPE DEFAULTS"
                android:textColor="@color/text_dim" android:textSize="10sp" android:letterSpacing="0.1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Swipe duration (ms)"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
            <Button android:id="@+id/btnSwipeDurMinus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="−" />
            <TextView android:id="@+id/tvSwipeDurValue"
                android:layout_width="52dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="300"
                android:textColor="@color/text_light" android:textSize="12sp" />
            <Button android:id="@+id/btnSwipeDurPlus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="+" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Swipe jitter (px)"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
            <Button android:id="@+id/btnSwipeJitterMinus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="−" />
            <TextView android:id="@+id/tvSwipeJitterValue"
                android:layout_width="52dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="0"
                android:textColor="@color/text_light" android:textSize="12sp" />
            <Button android:id="@+id/btnSwipeJitterPlus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="+" />
        </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="WAIT DEFAULT"
                android:textColor="@color/text_dim" android:textSize="10sp" android:letterSpacing="0.1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wait step default (ms)"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
            <Button android:id="@+id/btnWaitMinus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="−" />
            <TextView android:id="@+id/tvWaitValue"
                android:layout_width="52dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="500"
                android:textColor="@color/text_light" android:textSize="12sp" />
            <Button android:id="@+id/btnWaitPlus"
                android:layout_width="32dp" android:layout_height="32dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/text_light" android:textSize="14sp" android:text="+" />
        </LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="PROFILES"
                android:textColor="@color/text_dim" android:textSize="10sp" android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/editProfileName"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@drawable/edit_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:hint="Profile name"
                    android:textColorHint="@color/text_dim"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="64dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/btn_primary"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnProfilePrev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light" android:textSize="12sp"
                    android:text="◀" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="No saved profiles"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnProfileNext"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light" android:textSize="12sp"
                    android:text="▶" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button android:id="@+id/btnLoadProfile"
                    android:layout_width="0dp" android:layout_height="32dp"
                    android:layout_weight="1" android:minHeight="0dp"
                    android:background="@drawable/btn_secondary"
                    android:text="Load" android:textAllCaps="false"
                    android:textColor="@color/text_light" android:textSize="11sp" />

                <Button android:id="@+id/btnDeleteProfile"
                    android:layout_width="0dp" android:layout_height="32dp"
                    android:layout_weight="1" android:layout_marginStart="4dp" android:minHeight="0dp"
                    android:background="@drawable/btn_danger"
                    android:text="Delete" android:textAllCaps="false"
                    android:textColor="@color/text_light" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button android:id="@+id/btnExportProfile"
                    android:layout_width="0dp" android:layout_height="32dp"
                    android:layout_weight="1" android:minHeight="0dp"
                    android:background="@drawable/btn_secondary"
                    android:text="Copy (share)" android:textAllCaps="false"
                    android:textColor="@color/text_light" android:textSize="11sp" />

                <Button android:id="@+id/btnImportProfile"
                    android:layout_width="0dp" android:layout_height="32dp"
                    android:layout_weight="1" android:layout_marginStart="4dp" android:minHeight="0dp"
                    android:background="@drawable/btn_primary"
                    android:text="Paste import" android:textAllCaps="false"
                    android:textColor="@color/text_light" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:background="@drawable/btn_primary"
                android:text="▶  Start"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_danger"
                android:enabled="false"
                android:text="■  Stop"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/bubbleView"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bubble_bg"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/text_light"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
