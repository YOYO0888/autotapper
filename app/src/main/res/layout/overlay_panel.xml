<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="10dp"
        android:minWidth="252dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dragHandle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⠿  AutoTapper"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="13sp"
                android:padding="4dp" />

            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/btnToggleSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textColor="@color/text_dim"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Status chip -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/status_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Set a tap point or swipe points to begin."
            android:textColor="@color/text_light"
            android:textSize="11sp" />

        <!-- Point setters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnSetTap"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:background="@drawable/btn_secondary"
                android:text="Set Tap"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSetScroll"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_secondary"
                android:text="Set Swipe"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConfirmPositions"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_primary"
            android:text="Confirm Position"
            android:textAllCaps="false"
            android:textColor="@color/text_light"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnClearPoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp"
            android:text="Clear points"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <!-- Settings (collapsible) -->
        <LinearLayout
            android:id="@+id/tuningContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="TIMING"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Loop interval (ms)"
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnIntervalMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="−" />
                <TextView
                    android:id="@+id/tvIntervalValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1500"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnIntervalPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Swipe speed (ms)"
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnSlideMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="−" />
                <TextView
                    android:id="@+id/tvSlideValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="300"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnSlidePlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delay after swipe (ms)"
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnClickDelayMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="−" />
                <TextView
                    android:id="@+id/tvClickDelayValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="300"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnClickDelayPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="+" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="TAPPING"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tap radius (px)"
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnRadiusMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="−" />
                <TextView
                    android:id="@+id/tvRadiusValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnRadiusPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Taps per cycle"
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnTapCountMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="−" />
                <TextView
                    android:id="@+id/tvTapCountValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnTapCountPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gap between taps (ms)"
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnTapGapMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="−" />
                <TextView
                    android:id="@+id/tvTapGapValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="150"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnTapGapPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Swipe jitter (px)"
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnJitterMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="−" />
                <TextView
                    android:id="@+id/tvJitterValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnJitterPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cycles (0 = forever)"
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnCyclesMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="−" />
                <TextView
                    android:id="@+id/tvCyclesValue"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnCyclesPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:text="+" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="PROFILES"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/editProfileName"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@drawable/edit_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:hint="Profile name"
                    android:textColorHint="@color/text_dim"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="64dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/btn_primary"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnProfilePrev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="12sp"
                    android:text="◀" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="No saved profiles"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnProfileNext"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="@color/text_light"
                    android:textSize="12sp"
                    android:text="▶" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnLoadProfile"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@drawable/btn_secondary"
                    android:text="Load"
                    android:textAllCaps="false"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnDeleteProfile"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:minHeight="0dp"
                    android:background="@drawable/btn_danger"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="@color/text_light"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Start / Stop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:background="@drawable/btn_primary"
                android:text="▶  Start"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_danger"
                android:enabled="false"
                android:text="■  Stop"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Minimized bubble -->
    <TextView
        android:id="@+id/bubbleView"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bubble_bg"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/text_light"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
