<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AutoTapper"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scroll + tap a button on a loop, on any app, until you stop it."
        android:textAlignment="center"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/statusAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Accessibility service: OFF"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Accessibility Service"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/statusOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Overlay permission: OFF"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Overlay Permission"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnLaunchControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Launch Floating Controls"
        android:backgroundTint="@color/accent"
        android:enabled="false" />

</LinearLayout>
