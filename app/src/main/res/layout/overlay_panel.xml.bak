<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel_bg"
    android:padding="8dp"
    android:minWidth="220dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dragHandle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⠿ AutoTapper"
            android:textColor="@color/text_light"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:padding="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set scroll and tap points to begin."
        android:textColor="@color/text_light"
        android:textSize="11sp"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnSetScroll"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Scroll Points"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnSetTap"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Set Tap Point"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnConfirmPositions"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Confirm Position"
        android:backgroundTint="@color/accent"
        android:visibility="gone"
        android:textSize="12sp" />

    <!-- Loop interval -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Interval (ms):"
            android:textColor="@color/text_light"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnIntervalMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvIntervalValue"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1500"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnIntervalPlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>

    <!-- Slide speed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Slide (ms):"
            android:textColor="@color/text_light"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSlideMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvSlideValue"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="300"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSlidePlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>

    <!-- Click delay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Click delay (ms):"
            android:textColor="@color/text_light"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnClickDelayMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvClickDelayValue"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="300"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnClickDelayPlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wait after swipe before tap"
        android:textColor="@color/text_light"
        android:textSize="9sp"
        android:alpha="0.7"
        android:layout_marginTop="1dp" />

    <!-- Tap radius -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap radius (px):"
            android:textColor="@color/text_light"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnRadiusMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvRadiusValue"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRadiusPlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 = exact same spot"
        android:textColor="@color/text_light"
        android:textSize="9sp"
        android:alpha="0.7"
        android:layout_marginTop="1dp" />

    <!-- Tap count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap count:"
            android:textColor="@color/text_light"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnTapCountMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvTapCountValue"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTapCountPlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>

    <!-- Tap gap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap gap (ms):"
            android:textColor="@color/text_light"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnTapGapMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvTapGapValue"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="150"
            android:textColor="@color/text_light"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTapGapPlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Spread multiple taps over time"
        android:textColor="@color/text_light"
        android:textSize="9sp"
        android:alpha="0.7"
        android:layout_marginTop="1dp" />

    <!-- Scroll jitter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scroll jitter (px):"
            android:textColor="@color/text_light"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/editScrollJitter"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:inputType="number"
            android:text="0"
            android:textColor="@color/text_light"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 = exact line every time"
        android:textColor="@color/text_light"
        android:textSize="9sp"
        android:alpha="0.7"
        android:layout_marginTop="1dp" />

    <!-- Start/Stop buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start"
            android:backgroundTint="@color/accent"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Stop"
            android:backgroundTint="@color/danger"
            android:enabled="false"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
